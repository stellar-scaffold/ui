{
  "name": "@stellar-scaffold/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "prestart": "node scripts/dev-guard.mjs",
    "start": "npm start --workspace app",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "workspaces": [
    "templates/*",
    "app-lib",
    "app-lib/clients/*",
    "e2e"
  ],
  "devDependencies": {
    "@theahaco/ts-config": "^1.3.0",
    "prettier": "^3.8.3"
  },
  "prettier": "@theahaco/ts-config/prettier"
}
